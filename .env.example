# Reference only; this file is not loaded automatically.
# Local Groww helpers use the existing Windows DPAPI credential store via stdin.
# Oracle secrets stay in /etc/growing-trader/call-seller.env, root-owned 0600.
# Keep the existing verified sender and approved recipient; do not commit values.
RESEND_API_KEY=
TRADING_REPORT_FROM=
TRADING_REPORT_TO=

# Existing optional news-model integration. Unavailable inference/news stays UNKNOWN.
CALL_SELLER_LLM_URL=https://api.zetbros.com/v1/chat/completions
CALL_SELLER_LLM_MODEL=qwen3.8-27b
CALL_SELLER_LLM_KEY=

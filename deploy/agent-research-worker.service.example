# TEMPLATE ONLY. Not installed/enabled. Review paths, identities and isolation.
[Unit]
Description=Growing Trader headless research worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=growing-analyst
Group=growing-research-state
WorkingDirectory=/opt/growing-trader
Environment=PYTHONPATH=/opt/growing-trader/src
# Auth-only CODEX_HOME is private to growing-analyst. NO broker/mail EnvironmentFile.
ExecCondition=/usr/bin/test ! -e /opt/growing-trader/.trader-paused
ExecStart=/usr/bin/python3 -m nifty_engine.agent_engine.launch worker --config /etc/growing-trader/agent-engine.json worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillMode=control-group
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/growing-research /var/lib/growing-analyst
ReadOnlyPaths=/opt/growing-trader /var/lib/growing-trader-feed
InaccessiblePaths=-/etc/growing-trader/call-seller.env
ProtectProc=invisible
PrivateDevices=true
RestrictSUIDSGID=true
TasksMax=48
MemoryMax=192M
CPUQuota=25%

[Install]
WantedBy=multi-user.target

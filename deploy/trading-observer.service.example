[Unit]
Description=Trading Oracle read-only observer and visual daily email
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=trading-observer
Group=trading-observer
WorkingDirectory=/var/lib/trading-observer
EnvironmentFile=/etc/growing-trader/observer.env
# Replace RELEASE with the reviewed immutable commit; do not reuse the old trader.
ExecStart=/opt/growing-trader/releases/RELEASE/venv/bin/python -I -m nifty_engine.agent_engine.oracle_runtime serve --root /var/lib/trading-observer
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/trading-observer
# Normal collection briefly exceeds 160M; avoid reclaim stalls during snapshots.
MemoryHigh=192M
MemoryMax=240M
TasksMax=48
# At most one CPU on the two-CPU VM; retain lower priority for shared services.
CPUQuota=100%
Nice=10
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
